# Maintainer: nxvxrloseee
pkgname=muzon
pkgver=1.6.0
pkgrel=1
pkgdesc="Local music player built with Tauri and GStreamer"
arch=('x86_64')
url="https://github.com/nxvxrloseee/muzon"
license=('GPL3')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-plugins-ugly'
  'gst-libav'
  # secret-tool: ключи S3 и токены скробблинга хранятся в связке ключей системы
  'libsecret'
  # иконка в трее (StatusNotifierItem)
  'libayatana-appindicator'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'npm'
)
source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/nxvxrloseee/muzon/archive/v$pkgver.tar.gz"
  "$pkgname.desktop"
)
sha256sums=('621315f3d6fa25b236d7b5f38c0b1ad3f6ec55a42c45d9e714b7f62cb87e9e69'
            '1aa81d0d072346d9dd30516ec3e802d90da12a737cd55fc5bec2e2a24a2a3738')

build() {
  cd "$pkgname-$pkgver"
  # Arch's default CFLAGS enable GCC LTO, which produces fat-LTO objects for the
  # bundled sqlite3.c (compiled via the `cc` crate). The final Rust link step uses
  # lld, which can't consume GCC's LTO bytecode format, so libsqlite3.a silently
  # contributes no real symbols and the link fails with "undefined symbol:
  # sqlite3_*". Strip LTO for this build only.
  export CFLAGS="${CFLAGS//-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
  npm ci
  npm run tauri build -- --no-bundle
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$srcdir/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

pkgbase = muzon-native
	pkgdesc = Native Rust/Iced music player with GStreamer
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/nxvxrloseee/muzon
	arch = x86_64
	license = GPL-3.0-only
	checkdepends = python
	makedepends = cargo
	makedepends = pkgconf
	depends = glibc
	depends = libgcc
	depends = bash
	depends = hicolor-icon-theme
	depends = glib2
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = gst-plugins-bad
	depends = gst-libav
	depends = dbus
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = vulkan-icd-loader
	depends = libglvnd
	depends = xdg-desktop-portal
	optdepends = libsecret: secure S3 keys and scrobbling credentials via secret-tool
	optdepends = xdg-desktop-portal-gtk: file chooser backend if the desktop has none
	optdepends = zenity: fallback native folder dialog
	optdepends = gst-plugins-ugly: additional audio codecs
	optdepends = vulkan-driver: GPU rendering through Vulkan
	optdepends = alsa-utils: inspect ALSA hardware outputs for direct playback
	optdepends = python: import an existing library into a separate native profile
	options = !lto

pkgname = muzon-native
